# GPU Large — v1 baselines on real datasets, and large-B v3 runs.
#
# v1's pseudo-completion weight is (F, B, B): 3.1 GB of VRAM on ORL, and it is
# built on the HOST before .to(device), so host memory must exceed the device
# figure. Anything past ORL needs 39 GB+ and will not fit any single GPU — those
# rows exist in the paper as "infeasible by construction", not as jobs.

universe = container
container_image = docker://$(image_name)

executable = chtc/scripts/run_experiment.sh
arguments  = $(version) $(dataset) $(bsize) $(missing) $(seed) $(rankpseudo) $(tag) $(extra_args)

# Comma-separated list, built by generate_jobs.py: the tarball plus the one
# .mat this job needs (largest 44 MB, inside HTCondor limits — no /staging).
transfer_input_files = $(inputs)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = results.tar.gz
transfer_output_remaps = "results.tar.gz = tars/results_$(Cluster)_$(Process).tar.gz"

request_gpus = 1
# SAME-GPU RULE. Per-iteration time and peak VRAM are only comparable across
# methods when every job ran on the same card model, so this tier pins one.
# Default is the L40S (46 GB, plentiful on CHTC, and what the smoke test got).
# Find the exact strings CHTC advertises with:
#   condor_status -compact -constraint 'GPUs > 0' -af GPUs_DeviceName | sort | uniq -c
# Override per DAG with gpu_model="..." in VARS. Every shard records
# torch.cuda.get_device_name(), and --aggregate flags any mixed-GPU group.
# gpu_model has NO inline default on purpose: HTCondor's $(name:default) parser
# stops at whitespace, so "$(gpu_model:NVIDIA L40S)" was left UNEXPANDED and
# compared literally — matching zero GPUs. generate_jobs.py always emits
# gpu_model in the DAG VARS. Submitting this file by hand needs -a gpu_model=...
require_gpus = (DeviceName == "$(gpu_model)") && (GlobalMemoryMb >= $(gpu_mem_min:40000)) && (Capability >= $(gpu_cap_min:7.5)) && (Capability <= $(gpu_cap_max:12.0))
+WantGPULab   = true
# Lets the job run on backfill GPUs in researcher-owned machines, where it
# can be evicted and restarted. Every DUC job writes its shard only at the
# end, so a restart just reruns it. The free H200/L40S cards are all
# owner-reserved (Start = false); the backfill slots on those machines were
# all running jobs that set this flag, and ours, without it, never got one.
+is_resumable = true
# "short" = up to 12 h. This tier exists for host RAM, not runtime: ORL v1 took
# ~9 min on an L40S and the largest v3 job (Flowers, 3000-iteration cap) well
# under an hour. "medium" only put these jobs under a second, smaller
# per-user concurrency cap (GPULAB_MEDIUM) on top of the short one.
+GPUJobLength = "short"

request_cpus   = 4
request_memory = $(req_mem:32GB)
request_disk   = $(req_disk:20GB)

output = logs/$(Cluster).$(Process).out
error  = logs/$(Cluster).$(Process).err
log    = logs/$(Cluster).$(Process).log

# Do not re-match the machine a job just failed on. A node with a broken
# NVIDIA container hook (e.g. "failed to create link libcuda.so.1 ...
# bad file descriptor") fails in seconds, so it grabs the same jobs over
# and over and drains the DAG onto one dead machine.
# To exclude a specific known-bad host, add to the DAG VARS:
#   bad_node="gpu4003.chtc.wisc.edu"
# jcaicedogpu0004: its L40S raised "uncorrectable ECC error" on every DUC job
# placed there (4 of 4, 2026-09-24). Override with bad_node="..." in VARS.
requirements = (Machine =!= LastRemoteHost) && (Machine != "$(bad_node:jcaicedogpu0004.chtc.wisc.edu)")

max_retries = 5

queue
