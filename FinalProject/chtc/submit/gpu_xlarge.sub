# GPU XLarge — v1 on EYaleB (61.5 GB; COIL20 fits the L40S), plus the v3 runs
# paired with them for a same-hardware timing comparison.
#
# v1's pseudo-completion PARAMETERS are constructed on the host as F separate
# nn.Linear layers before .to(device) — 8.5 GB for COIL20, 13 GB for EYaleB.
# Gradients and Adam state are allocated on the GPU afterwards, so the host
# request only needs to cover params + overhead, NOT the 40-62 GB GPU total.
# These only fit 80+ GB cards and will queue until one frees up.

universe = container
container_image = docker://$(image_name)

executable = chtc/scripts/run_experiment.sh
arguments  = $(version) $(dataset) $(bsize) $(missing) $(seed) $(rankpseudo) $(extra_args)

transfer_input_files = $(inputs)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = results.tar.gz
transfer_output_remaps = "results.tar.gz = tars/results_$(Cluster)_$(Process).tar.gz"

request_gpus = 1
# SAME-GPU RULE. Per-iteration time and peak VRAM are only comparable across
# methods when every job ran on the same card model, so this tier pins one.
# This tier needs 80+ GB. CHTC (Sep 2026) advertises 11x A100-SXM4-80GB,
# 6x H200 and a single RTX PRO 6000. The A100 pin sat idle for 4 days without
# matching a slot (GPU Lab membership or DeviceName string), so the default is
# now the H200 pool. Check what a pinned card actually advertises with:
#   condor_status -compact -constraint 'GPUs>0 && regexp("H200",GPUs_DeviceName)' -af Machine GPUs_DeviceName GPUs_GlobalMemoryMb Memory
# Find the exact strings CHTC advertises with:
#   condor_status -compact -constraint 'GPUs > 0' -af GPUs_DeviceName | sort | uniq -c
# Override per DAG with gpu_model="..." in VARS. Every shard records
# torch.cuda.get_device_name(), and --aggregate flags any mixed-GPU group.
require_gpus = (DeviceName == "$(gpu_model:NVIDIA H200)") && (GlobalMemoryMb >= $(gpu_mem_min:75000)) && (Capability >= $(gpu_cap_min:8.0)) && (Capability <= $(gpu_cap_max:12.0))
+WantGPULab   = true
# v1 at B=1440 is roughly 13x the work of ORL's 1.3 s/iter; allow a long run.
+GPUJobLength = "long"

request_cpus   = 4
request_memory = $(req_mem:32GB)
request_disk   = $(req_disk:20GB)

output = logs/$(Cluster).$(Process).out
error  = logs/$(Cluster).$(Process).err
log    = logs/$(Cluster).$(Process).log

requirements = (Machine =!= LastRemoteHost) && (Machine != "$(bad_node:no.such.host)")

max_retries = 5

queue
