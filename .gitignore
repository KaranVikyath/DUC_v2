__pycache__/
logs/
PLAN.md

# CUDA extension build artifacts (any location)
**/*.egg-info/
**/cuda_kernels/build/
**/cuda_kernels/*.egg-info/

# Project-specific data outputs
FinalProject/data/logs/

# Keep the FinalProject/build/ directory but ignore its contents (except .gitkeep)
FinalProject/build/*
!FinalProject/build/.gitkeep

# Slurm output logs
slurm-*.out
slurm-*.err

# Datasets — ~128 MB, staged to CHTC rather than committed (see FinalProject/chtc/README.md)
FinalProject/data/*.mat
FinalProject/data/*.csv

# Experiment outputs
FinalProject/data/shards/
FinalProject/data/*.backup.json
FinalProject/chtc/dag/*.dag
FinalProject/chtc/logs/
FinalProject/chtc/tars/
FinalProject/chtc/results/
FinalProject/project.tar.gz

# Third-party SOTA baselines are fetched at pinned commits (Docker build or
# locally), never committed: several have no license or are GPL.
FinalProject/third_party/

# KFMC is a port of the authors' unlicensed MATLAB: kept private, copied to
# the submit node by hand so it rides in project.tar.gz but never in git.
FinalProject/src/sota/kfmc.py
